# Server Settings
PORT=5000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://your-production-domain.com"
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@hostname:5432/curalink?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:5432/curalink?sslmode=require"

# JWT Config (Must be at least 32 characters, recommend 64 characters)
JWT_SECRET="replace_with_64_character_cryptographically_secure_random_string_here"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Encryption (Must be 64 char hex string for 32 byte AES-256)
ENCRYPTION_KEY="replace_with_64_character_hex_string_for_aes_256_encryption_here_"

# E-Prescription Digital Signature Secret (Required in production, min 16 characters)
PRESCRIPTION_SECRET="replace_with_strong_random_prescription_signing_secret_key"

# Python ML Microservice (FastAPI risk triage)
ML_SERVICE_URL="http://localhost:8000"

# Admin Access Control (comma-separated whitelist of admin user emails)
ADMIN_EMAILS="admin@curalink.health,ops@curalink.health"

# OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here"

# Cloudflare Turnstile (Bot Protection)
# For local dev/testing only, Cloudflare official always-pass keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# AI Engine (Google Gemini / Anthropic Claude)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Video Consultation (Jitsi Meet / Daily.co)
JITSI_DOMAIN="meet.jit.si"
DAILY_API_KEY="your_daily_api_key_here"
DAILY_DOMAIN="your-subdomain.daily.co"

# Payments (Razorpay - required in production)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="CuraLink Healthcare <notifications@curalink.health>"
APP_URL="https://curalink.health"
API_URL="https://curalink-056t.onrender.com/api"
EMAIL_ENABLED=true
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_signing_secret_here"

# Legacy Email Fallback
EMAIL_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM_ADDRESS="CuraLink Healthcare <notifications@curalink.health>"

# Real SMS Notifications (optional, MSG91/Twilio)
SMS_API_KEY="your_sms_api_key_here"

# Medical Records File Storage (S3/Cloudinary)
STORAGE_API_KEY="your_storage_api_key_here"
STORAGE_BUCKET_NAME="curalink-medical-records"

# Location/Geocoding (Google Maps)
GEOCODING_API_KEY="your_google_maps_api_key_here"

# Error Monitoring (Sentry)
SENTRY_DSN="your_sentry_dsn_here"
