{
  "expo": {
    "name": "CuraLink",
    "slug": "curalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "curalink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.curalink.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CuraLink needs access to your camera for secure video consultations with doctors.",
        "NSMicrophoneUsageDescription": "CuraLink needs access to your microphone for secure video consultations with doctors.",
        "NSFaceIDUsageDescription": "CuraLink uses Face ID / Touch ID to securely unlock your medical records and consultations.",
        "NSLocationWhenInUseUsageDescription": "CuraLink uses your location to find nearby verified doctors and clinics."
      }
    },
    "android": {
      "package": "com.curalink.app",
      "adaptiveIcon": {
        "backgroundColor": "#006D77",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#06101B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CuraLink to use Face ID and Fingerprint to securely unlock your health records."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CuraLink to use your location to discover nearby verified doctors and clinics."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d943f7d5-8218-4811-b232-8c4e59bca675"
      }
    }
  }
}
