datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         String   @default("PATIENT")
  phone        String?
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  emailVerifiedAt DateTime?
  age          Int?
  gender       String?
  profileCompletedAt DateTime?
  noShowCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments    Appointment[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  payments        Payment[]
  doctorProfile   DoctorProfile?
  reviewsWritten  Review[]        @relation("PatientReviews")
  reviewsReceived Review[]        @relation("DoctorReviews")
  prescriptions   Prescription[]  @relation("PatientPrescriptions")
  dataErasures    DataErasureRequest[]
  vitalLogs       VitalLog[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model DoctorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  medicalLicenseNumber String
  specialization       String
  experienceYears      Int      @default(0)
  consultationFee      Float    @default(500)
  consultationModes    String[] @default(["VIDEO"]) // VIDEO, IN_PERSON
  verificationStatus   String   @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedAt           DateTime?
  bio                  String?
  city                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([verificationStatus, experienceYears])
  @@index([verificationStatus, city])
  @@map("doctor_profiles")
}

model Appointment {
  id        String   @id @default(uuid())
  userId    String
  doctorId  String
  date      String
  time      String
  status    String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  roomName  String?
  roomUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  payment      Payment?
  prescription Prescription?
  review       Review?
  messages     Message[]
  reminders    AppointmentReminder[]

  @@index([doctorId, date])
  @@index([userId, status])
  @@map("appointments")
}

model Payment {
  id                String   @id @default(uuid())
  appointmentId     String   @unique
  userId            String
  amount            Float
  currency          String   @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  diagnosis     String
  medications   String   // JSON string of [{ name, dosage, frequency, duration }]
  notes         String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User        @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  doctorId      String
  patientId     String
  rating        Int      // 1 to 5 stars
  comment       String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User        @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User        @relation("DoctorReviews", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt])
  @@map("reviews")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   String? // Stored as JSON string
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model DataErasureRequest {
  id        String   @id @default(uuid())
  userId    String
  reason    String?
  status    String   @default("PENDING") // PENDING, PROCESSED, REJECTED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_erasure_requests")
}

model VitalLog {
  id              String   @id @default(uuid())
  userId          String
  systolicBp      Int?     // mmHg (e.g. 120)
  diastolicBp     Int?     // mmHg (e.g. 80)
  bloodGlucose    Float?   // mg/dL (e.g. 110.5)
  glucoseType     String?  @default("FASTING") // FASTING, POST_PRANDIAL, RANDOM
  weight          Float?   // kg (e.g. 72.5)
  heartRate       Int?     // bpm (e.g. 72)
  spO2            Int?     // % (e.g. 98)
  temperature     Float?   // °F (e.g. 98.6)
  notes           String?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("vital_logs")
}

model Message {
  id            String      @id @default(uuid())
  appointmentId String
  senderId      String
  receiverId    String
  content       String
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([senderId, receiverId])
  @@map("messages")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model NotificationLog {
  id                String    @id @default(uuid())
  recipientId       String?
  recipientEmail    String
  subject           String
  eventType         String    // VERIFICATION, WELCOME, DOCTOR_REGISTRATION, DOCTOR_APPROVED, DOCTOR_REJECTED, APPOINTMENT_BOOKED, APPOINTMENT_CONFIRMED, APPOINTMENT_CANCELLED, APPOINTMENT_RESCHEDULED, APPOINTMENT_REMINDER, PASSWORD_RESET, PASSWORD_CHANGED
  status            String    @default("PENDING") // PENDING, SENT, FAILED, DELIVERED, BOUNCED, COMPLAINED
  provider          String    @default("RESEND")
  providerMessageId String?   @unique
  errorMessage      String?
  idempotencyKey    String?   @unique
  metadata          String?   // JSON string
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([recipientEmail])
  @@index([eventType, status])
  @@index([createdAt])
  @@map("notification_logs")
}

model AppointmentReminder {
  id            String    @id @default(uuid())
  appointmentId String
  reminderType  String    // '24H' | '1H'
  scheduledFor  DateTime
  sentAt        DateTime?
  status        String    @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, reminderType])
  @@index([status, scheduledFor])
  @@map("appointment_reminders")
}


